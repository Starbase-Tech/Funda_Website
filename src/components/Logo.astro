---
import { Image } from 'astro:assets'
import logo from '../assets/brand/funda-logo.png'
import mark from '../assets/brand/funda-mark.png'

interface Props {
  /** Rendered height in px */
  height?: number
  /** Just the F mark, without the wordmark */
  markOnly?: boolean
}
const { height = 32, markOnly = false } = Astro.props
const src = markOnly ? mark : logo
---

<Image
  src={src}
  alt="Funda"
  height={height}
  densities={[1, 2]}
  class="logo"
  loading="eager"
/>

<style is:global>
  .logo { display: block; width: auto; }
</style>
