---
import Logo from './Logo.astro'
import { PHONES, WHATSAPP } from '../data/contact'

// Section links point back to the home page when shown on other pages
const home = Astro.url.pathname === '/' ? '' : '/'
---

<footer class="foot">
  <div class="wrap">
    <div class="foot-big display" aria-hidden="true">Funda</div>
    <div class="foot-contact">
      <span class="foot-contact-label">Talk to us</span>
      <a href={`https://wa.me/${WHATSAPP.number}`} target="_blank" rel="noopener">WhatsApp · {WHATSAPP.label}</a>
      {PHONES.map((p) => <a href={`tel:${p.tel}`}>Call · {p.label}</a>)}
    </div>
    <div class="foot-row">
      <Logo height={30} />
      <nav aria-label="Footer">
        <a href={`${home}#tour`}>Product</a>
        <a href={`${home}#roles`}>Permissions</a>
        <a href={`${home}#features`}>Features</a>
        <a href={`${home}#pricing`}>Pricing</a>
        <a href={`${home}#contact`}>Contact</a>
      </nav>
      <span class="foot-credit">
        © {new Date().getFullYear()} Funda · Made in Zimbabwe ·
        Powered by <a href="https://starbasetech.africa" target="_blank" rel="noopener">Starbase Technologies</a>
      </span>
    </div>
    <div class="foot-legal">
      <a href="/terms">Terms and Conditions</a>
      <a href="/privacy">Privacy Policy</a>
      <span>Prices are subject to change.</span>
    </div>
  </div>
</footer>

<style is:global>
  .foot { background: var(--tint); color: var(--muted); padding: 40px 0 36px; overflow: hidden; }
  .foot-big {
    font-size: clamp(80px, 21vw, 300px);
    letter-spacing: -0.05em;
    line-height: 0.8;
    text-align: center;
    background: linear-gradient(180deg, rgba(8, 119, 255, 0.16), rgba(8, 119, 255, 0));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    margin-bottom: 30px;
    user-select: none;
  }
  .foot-contact { display: flex; align-items: center; justify-content: center; gap: 10px 28px; flex-wrap: wrap; font-size: 15px; padding: 22px 0; border-top: 1px solid var(--paper-line); }
  .foot-contact-label { color: var(--text); font-weight: 600; }
  .foot-contact a { color: var(--text); white-space: nowrap; border-bottom: 1px solid var(--paper-line); transition: border-color 0.2s; }
  .foot-contact a:hover { border-color: var(--blue); }
  .foot-row { display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; font-size: 14px; padding-top: 28px; border-top: 1px solid var(--paper-line); }
  .foot-row nav { display: flex; gap: 26px; }
  .foot-legal { display: flex; flex-wrap: wrap; gap: 8px 24px; margin-top: 18px; font-size: 13px; }
  .foot-legal a { color: var(--text); border-bottom: 1px solid var(--paper-line); transition: border-color 0.2s; }
  .foot-legal a:hover { border-color: var(--blue); }
  .foot-row nav a:hover { color: var(--text); }
  .foot-credit a { color: var(--text); font-weight: 500; border-bottom: 1px solid var(--paper-line); transition: border-color 0.2s; }
  .foot-credit a:hover { border-color: var(--blue); }
  @media (max-width: 760px) {
    .foot-row nav { flex-wrap: wrap; gap: 14px 22px; }
  }
</style>
